# 微言微博模板 - 环境变量配置
# 复制此文件为 .env 并修改相应值

# ===== 站点配置 =====
SITE_TITLE=微言
SITE_DESCRIPTION=一个极简的微博模板
SITE_AUTHOR=你的名字
SITE_URL=https://your-domain.com

# ===== 构建配置 =====
NODE_ENV=development
BUILD_MODE=dev

# ===== 功能开关 =====
ENABLE_PWA=true
ENABLE_ANALYTICS=false
ENABLE_COMMENTS=false

# ===== 主题 =====
THEME=light

# ===== 部署配置 =====
GITHUB_REPO=your-username/weibo-template
DEPLOY_TARGET=github-pages
